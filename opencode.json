{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "documentador": {
      "mode": "subagent",
      "description": "Analiza el frontend del proyecto y genera documentación técnica completa en español.",
      "prompt": "{file:./opencode/agents/documentador/documentador.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "list": true,
        "write": true,
        "edit": true,
        "bash": true,
        "webfetch": false
      },
      "permission": {
        "edit": {
          "*": "deny",
          "reports/documentador/*": "allow"
        },
        "bash": {
          "*": "deny",
          "find *": "allow",
          "ls *": "allow",
          "wc -l *": "allow",
          "grep *": "allow",
          "cat package.json": "allow",
          "cat *.config.*": "allow"
        },
        "webfetch": "deny"
      }
    },
    "technical-analysis": {
      "mode": "subagent",
      "description": "Genera un analisis técnico del proyecto, incluyendo arquitectura, dependencias y puntos críticos.",
      "prompt": "{file:./opencode/agents/technical-analysis/technical-analysis.md}",
      "permission": {
        "bash": {
          "*": "deny",
          "ls *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "cat *": "allow",
          "tree *": "allow",
          "wc *": "allow"
        },
        "read": {
          "*": "allow",
          ".env": "deny",
          ".env.local": "deny",
          ".env.development": "deny",
          ".env.production": "deny",
          ".env.*.local": "deny"
        },
        "webfetch": "deny",
        "edit": {
            "*": "deny",
            "reports/technical-analysis/*": "allow"
        }
      }
    },
    "dependency-auditor": {
      "mode": "subagent",
      "prompt": "{file:./opencode/agents/dependency-auditor/dependency-auditor.md}"
    }
  }
}
